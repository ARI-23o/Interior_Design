<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect sowakaahdesigns.in to sowakaahdesigns.com
  RewriteCond %{HTTP_HOST} ^(www\.)?sowakaahdesigns\.in$ [NC]
  RewriteRule ^(.*)$ https://sowakaahdesigns.com/ [R=301,L]

  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Direct file or directory requests serve normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA Routing: Send all other requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>
